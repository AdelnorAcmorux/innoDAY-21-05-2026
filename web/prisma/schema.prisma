// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js required tables ───────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application models ────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  image     String?
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  accounts         Account[]
  sessions         Session[]
  ideas            Idea[]
  ideaJoins        IdeaJoin[]
  challengeJoins   ChallengeJoin[]
  reactions        Reaction[]
  comments         Comment[]
  commentLikes     CommentLike[]
  challengeReports ChallengeReport[]
  startedChallenges Challenge[]      @relation("ChallengeStarter")
}

// An InnoDAY edition (quarterly event)
model Edition {
  id          String    @id @default(cuid())
  name        String    // e.g. "InnoDAY Q2 2026"
  slug        String    @unique // e.g. "q2-2026"
  description String?   @db.Text
  startsAt    DateTime
  endsAt      DateTime
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  ideas      Idea[]
  challenges Challenge[]
}

enum IdeaCategory {
  PROBLEM_SOLVING
  IMPROVEMENT
  EXPERIMENTATION
}

model Idea {
  id          String       @id @default(cuid())
  title       String
  description String       @db.Text
  category    IdeaCategory
  authorId    String
  editionId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  author    User       @relation(fields: [authorId], references: [id])
  edition   Edition    @relation(fields: [editionId], references: [id])
  challenge Challenge?
  joins     IdeaJoin[]
  reactions Reaction[]
  comments  Comment[]
}

// Soft interest signal — "I could work on this"
model IdeaJoin {
  id        String   @id @default(cuid())
  userId    String
  ideaId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@unique([userId, ideaId])
}

// Hard commitment — "I will work on this during InnoDAY"
model Challenge {
  id          String   @id @default(cuid())
  ideaId      String   @unique // 1 idea = max 1 challenge
  starterId   String
  editionId   String
  createdAt   DateTime @default(now())
  dissolvedAt DateTime?

  idea      Idea              @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  starter   User              @relation("ChallengeStarter", fields: [starterId], references: [id])
  edition   Edition           @relation(fields: [editionId], references: [id])
  joins     ChallengeJoin[]
  reports   ChallengeReport[]
  comments  Comment[]
}

model ChallengeJoin {
  id          String   @id @default(cuid())
  userId      String
  challengeId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
}

// Free-text report submitted by any challenge participant (multiple allowed, all preserved)
model ChallengeReport {
  id          String   @id @default(cuid())
  challengeId String
  authorId    String
  content     String   @db.Text
  createdAt   DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])
}

enum ReactionType {
  FIRE
  GEAR
}

// Toggle reactions on ideas (Fire or Gear)
model Reaction {
  id        String       @id @default(cuid())
  userId    String
  ideaId    String
  type      ReactionType
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@unique([userId, ideaId, type])
}

// Comments on ideas or challenges (threaded, Reddit-style via parentId)
model Comment {
  id          String    @id @default(cuid())
  content     String    @db.Text
  authorId    String
  ideaId      String?
  challengeId String?
  parentId    String?   // null = top-level, set = reply
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // soft delete

  author   User          @relation(fields: [authorId], references: [id])
  idea     Idea?         @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  challenge Challenge?   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  parent   Comment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[]     @relation("CommentReplies")
  likes    CommentLike[]
}

// Simple 👍 like on a comment
model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}
